        "nullable": "否",
        "key": "见表级约束"
      },
      {
        "field": "status",
        "type": "VARCHAR(16)",
        "definition": "VARCHAR(16) NOT NULL DEFAULT 'OPEN'",
        "comment": "岗位状态：OPEN开放、CLOSED关闭、ARCHIVED归档",
        "nullable": "否",
        "key": "见表级约束"
      },
      {
        "field": "created_at",
        "type": "DATETIME(3)",
        "definition": "DATETIME(3) NOT NULL DEFAULT CURRENT_TIMESTAMP(3)",
        "comment": "创建时间，UTC，精确到毫秒",
        "nullable": "否",
        "key": "见表级约束"
      }
    ],
    "constraints": [
      "FOREIGN KEY (company_id) REFERENCES companies(id)",
      "CONSTRAINT ck_job_quota CHECK (planned_count > 0 AND filled_count >= 0 AND filled_count <= planned_count)",
      "CONSTRAINT ck_job_status CHECK (status IN ('OPEN','CLOSED','ARCHIVED'))",
      "KEY ix_job_open(status,deadline)",
      "KEY ix_job_company(company_id)"
    ]
