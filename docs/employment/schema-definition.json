  {
    "table": "users",
    "comment": "原站账户映射及模块访问状态，不存储密码或Token",
    "columns": [
      {
        "field": "id",
        "type": "BIGINT",
        "definition": "BIGINT NOT NULL AUTO_INCREMENT",
        "comment": "本表主键，自增业务记录编号",
        "nullable": "否",
        "key": "PK，自增"
      },
      {
        "field": "external_user_id",
        "type": "BIGINT",
        "definition": "BIGINT NOT NULL",
        "comment": "原站用户主键，唯一映射；身份由原站核验",
        "nullable": "否",
        "key": "唯一"
      },
      {
        "field": "username",
        "type": "VARCHAR(64)",
        "definition": "VARCHAR(64) NOT NULL",
        "comment": "原站用户名快照，仅用于显示，不用于鉴权",
