  {
    "table": "jobs",
    "comment": "招聘岗位及名额，已录用人数由录用事务维护",
    "columns": [
      {
        "field": "id",
        "type": "BIGINT",
        "definition": "BIGINT NOT NULL AUTO_INCREMENT",
        "comment": "本表主键，自增业务记录编号",
        "nullable": "否",
        "key": "PK，自增"
      },
      {
        "field": "company_id",
        "type": "BIGINT",
        "definition": "BIGINT NOT NULL",
        "comment": "企业外键，关联companies.id，创建后不可变更",
        "nullable": "否",
        "key": "见表级约束"
      },
      {
        "field": "title",
        "type": "VARCHAR(120)",
        "definition": "VARCHAR(120) NOT NULL",
        "comment": "招聘岗位名称",
        "nullable": "否",
        "key": "见表级约束"
      },
      {
        "field": "category",
        "type": "VARCHAR(64)",
        "definition": "VARCHAR(64) NOT NULL",
        "comment": "岗位类别，例如技术、护理、运营",
        "nullable": "否",
        "key": "见表级约束"
      },
      {
        "field": "city",
        "type": "VARCHAR(64)",
        "definition": "VARCHAR(64) NOT NULL",
        "comment": "工作城市名称",
        "nullable": "否",
        "key": "见表级约束"
      },
      {
        "field": "description",
        "type": "TEXT",
        "definition": "TEXT NOT NULL",
        "comment": "职责、任职条件、培养安排及样例薪酬说明",
        "nullable": "否",
        "key": "见表级约束"
      },
      {
        "field": "planned_count",
        "type": "INT",
        "definition": "INT NOT NULL",
        "comment": "计划招聘人数，单位人，必须大于0",
        "nullable": "否",
        "key": "见表级约束"
      },
      {
        "field": "filled_count",
        "type": "INT",
        "definition": "INT NOT NULL DEFAULT 0",
        "comment": "已登记录用人数，单位人，不得超过计划名额",
