        "key": "见表级约束"
      },
      {
        "field": "role_id",
        "type": "BIGINT",
        "definition": "BIGINT NOT NULL",
        "comment": "模块角色外键，关联roles.id；管理员以原站身份为准",
        "nullable": "否",
        "key": "见表级约束"
      },
      {
        "field": "enabled",
        "type": "BOOLEAN",
        "definition": "BOOLEAN NOT NULL DEFAULT TRUE",
        "comment": "模块访问开关：1启用、0停用，不影响原站登录",
        "nullable": "否",
        "key": "见表级约束"
      },
      {
        "field": "last_seen_at",
        "type": "DATETIME(3)",
        "definition": "DATETIME(3) NOT NULL DEFAULT CURRENT_TIMESTAMP(3)",
        "comment": "最近通过原站核验的时间，UTC，毫秒",
        "nullable": "否",
        "key": "见表级约束"
      },
      {
        "field": "created_at",
        "type": "DATETIME(3)",
        "definition": "DATETIME(3) NOT NULL DEFAULT CURRENT_TIMESTAMP(3)",
        "comment": "创建时间，UTC，精确到毫秒",
        "nullable": "否",
        "key": "见表级约束"
      }
    ],
    "constraints": [
      "FOREIGN KEY (role_id) REFERENCES roles(id)"
    ]
  },
  {
    "table": "students",
    "comment": "学生档案，与模块账户一对一关联",
    "columns": [
      {
        "field": "id",
        "type": "BIGINT",
        "definition": "BIGINT NOT NULL AUTO_INCREMENT",
        "comment": "本表主键，自增业务记录编号",
        "nullable": "否",
        "key": "PK，自增"
      },
      {
        "field": "user_id",
        "type": "BIGINT",
        "definition": "BIGINT NOT NULL",
        "comment": "账户外键，关联users.id，一账户一份档案",
        "nullable": "否",
        "key": "唯一"
      },
      {
        "field": "student_no",
        "type": "VARCHAR(32)",
        "definition": "VARCHAR(32) NULL",
        "comment": "学生学号，填写后唯一；待完善时可为空",
        "nullable": "是",
        "key": "唯一"
      },
      {
        "field": "full_name",
        "type": "VARCHAR(64)",
        "definition": "VARCHAR(64) NULL",
        "comment": "学生姓名；样例姓名为虚构，不含真实身份信息",
        "nullable": "是",
        "key": "见表级约束"
      },
      {
        "field": "college",
        "type": "VARCHAR(100)",
        "definition": "VARCHAR(100) NULL",
        "comment": "所属学院名称",
        "nullable": "是",
        "key": "见表级约束"
      },
      {
        "field": "major",
        "type": "VARCHAR(100)",
        "definition": "VARCHAR(100) NULL",
        "comment": "所学专业名称",
        "nullable": "是",
        "key": "见表级约束"
      },
      {
        "field": "graduation_year",
        "type": "INT",
        "definition": "INT NULL",
        "comment": "预计毕业年份，四位年份，范围2000至2100",
        "nullable": "是",
        "key": "见表级约束"
      },
      {
        "field": "contact",
        "type": "VARCHAR(100)",
        "definition": "VARCHAR(100) NULL",
        "comment": "联系方式，例如邮箱或脱敏电话，最长100字符",
        "nullable": "是",
        "key": "见表级约束"
      },
      {
        "field": "profile_state",
        "type": "VARCHAR(16)",
        "definition": "VARCHAR(16) NOT NULL DEFAULT 'DRAFT'",
        "comment": "档案状态：DRAFT待完善、COMPLETE已完善",
        "nullable": "否",
        "key": "见表级约束"
      },
      {
        "field": "updated_at",
        "type": "DATETIME(3)",
        "definition": "DATETIME(3) NOT NULL DEFAULT CURRENT_TIMESTAMP(3)",
        "comment": "最近业务更新时间，UTC，精确到毫秒",
        "nullable": "否",
        "key": "见表级约束"
      }
    ],
    "constraints": [
      "FOREIGN KEY (user_id) REFERENCES users(id)",
      "CONSTRAINT ck_student_year CHECK (graduation_year IS NULL OR graduation_year BETWEEN 2000 AND 2100)",
      "CONSTRAINT ck_student_profile CHECK (profile_state IN ('DRAFT','COMPLETE'))",
      "KEY ix_student_cohort(graduation_year,college)"
    ]
  },
  {
